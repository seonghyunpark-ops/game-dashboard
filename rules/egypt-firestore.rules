rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 검증된 대시보드 관리자 5명만 목록 조회.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['hc.lee@theant.kr', 'hyunjin.kim@theant.kr', 'juyi.kim@theant.kr', 'hyerin.kim@theant.kr', 'seonghyun.park@theant.kr']
        && request.auth.token.email_verified == true;
    }

    match /coupons/{code} {
      allow get: if true;
      allow list: if isOwner();
      allow create, delete: if false;
      allow update: if resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.used_at is timestamp
        && request.resource.data.used_by is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'used_at', 'used_by']);
    }
  }
}
